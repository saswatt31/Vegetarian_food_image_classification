# ==============================================================================
# Git Ignore Configuration for Vegetarian Food Image Classification Project
# ==============================================================================

# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# ------------------------------------------------------------------------------
# Virtual Environments & Packaging
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
build/
dist/
*.egg-info/
.eggs/

# ------------------------------------------------------------------------------
# Jupyter Notebook Checkpoints & Cache
# ------------------------------------------------------------------------------
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# ------------------------------------------------------------------------------
# Unit Tests & Coverage
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# IDEs and Text Editors
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Operating System Artifacts
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory
.fuse_hidden*

# ------------------------------------------------------------------------------
# Temporary Files & Logs
# ------------------------------------------------------------------------------
*.log
*.tmp
*.temp
tmp/
temp/
scratch/

# Microsoft Office Temporary & Lock Files
# (Auto-generated when opening .docx / .pptx deliverables)
~$*.docx
~$*.pptx
~$*.xlsx

# ------------------------------------------------------------------------------
# Raw Datasets & Image Corpus
# Parquet files (>1.5 GB) and extracted corpus images (>3 GB, 6,200+ photos)
# exceed GitHub file limits and should be downloaded/extracted via pipeline:
#   curl ... -> python src/prepare_data.py --extract
# ------------------------------------------------------------------------------
raw/*.parquet
raw/images/
!raw/dataset_stats.json

# Processed dataset splits (2,000 photos, ~450 MB, generated by src/build_subset.py)
data/train/
data/validation/
data/test/
!data/split_summary.json

# Legacy synthetic dataset images
legacy_synthetic/data/train/
legacy_synthetic/data/val/
legacy_synthetic/data/test/
!legacy_synthetic/data/labels.csv

# ------------------------------------------------------------------------------
# Model Weights & Checkpoints (PyTorch / Deep Learning)
# Binary checkpoints (~45 MB each)
# ------------------------------------------------------------------------------
*.pth
*.pt
*.ckpt
*.bin
*.onnx
*.h5

# NOTE: If you wish to track the trained model weights directly in git
# (models/best_model.pth is ~44.8 MB, within GitHub's 100 MB per-file limit),
# uncomment the line below:
# !models/best_model.pth
